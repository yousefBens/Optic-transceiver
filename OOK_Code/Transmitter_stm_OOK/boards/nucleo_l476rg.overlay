#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,console = &usart2;
    };

    zephyr,user {
        data-gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
    };
};

/* The Nucleo's 32.768 kHz crystal calibrates MSI; no ST-Link HSE/MCO required. */
&clk_lse {
    status = "okay";
};

&clk_msi {
    msi-range = <6>; /* 4 MHz */
    msi-pll-mode;
    status = "okay";
};

&pll {
    clocks = <&clk_msi>;
    div-m = <1>;
    mul-n = <40>;
    div-r = <2>; /* 4 MHz * 40 / 2 = 80 MHz */
    div-q = <4>;
};

/* PA9 is driven as GPIO by DMA, not by USART1's alternate function. */
&usart1 {
    status = "disabled";
};

&timers2 {
    st,prescaler = <0>;
    status = "okay";

    pwm {
        status = "disabled";
    };

    t_bit: counter {
        compatible = "st,stm32-counter";
        status = "okay";
    };
};
